{
  "name": "rs-map-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@foxglove/wasm-bz2": "^0.1.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^22.7.6",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@webgpu/types": "^0.1.40",
    "bzip2": "^0.1.1",
    "denque": "^2.1.0",
    "fast-memoize": "^2.5.2",
    "file-saver": "^2.0.5",
    "gl-matrix": "^3.4.3",
    "gzip-js": "^0.3.2",
    "java-random": "^0.4.0",
    "js-xxhash": "^2.0.0",
    "jszip": "^3.10.1",
    "leva": "^0.9.35",
    "picogl": "^0.17.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-joystick-component": "^6.2.1",
    "react-modal": "^3.16.1",
    "react-router-dom": "^6.14.2",
    "react-select": "^5.7.4",
    "threads": "^1.7.0",
    "typescript": "^5.1.6",
    "usehooks-ts": "^2.9.1",
    "vite": "^5.4.9",
    "vite-plugin-glsl": "^1.3.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "wasm-gzip": "^1.0.1",
    "web-vitals": "^2.1.0",
    "webfontloader": "^1.6.28",
    "xxhash-wasm": "^1.0.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "prettier --write \"./**/*.{js,ts,jsx,tsx,css,md}\"",
    "prepare": "husky install",
    "download-caches": "node scripts/download-caches.js",
    "rs:layer-check": "node scripts/rs-layer-check.mjs",
    "rs:portability-check": "node scripts/rs-portability-check.mjs",
    "cache:parity": "TS_NODE_PROJECT=scripts/tsconfig.tsnode.json node --experimental-specifier-resolution=node --loader ts-node/esm scripts/cache/cache-parity.ts",
    "export-textures": "TS_NODE_PROJECT=scripts/tsconfig.tsnode.json node --experimental-specifier-resolution=node --loader ts-node/esm scripts/cache/export-textures.ts",
    "generate-fixtures": "npx tsc -p scripts/cache-fixtures/tsconfig.cjs.json && node /tmp/rs-map-viewer-fixtures-gen/scripts/cache-fixtures/generate-fixtures.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "chrome >= 67",
      "edge >= 79",
      "firefox >= 68",
      "opera >= 54",
      "safari >= 14"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/gzip-js": "^0.3.3",
    "@types/react-modal": "^3.16.0",
    "@types/webfontloader": "^1.6.35",
    "adm-zip": "^0.5.10",
    "husky": "^8.0.3",
    "json-minimizer-webpack-plugin": "^4.0.0",
    "lint-staged": "^13.2.3",
    "path": "^0.12.7",
    "prettier": "^3.0.0",
    "sharp": "^0.32.6",
    "threads-plugin": "^1.4.0",
    "ts-node": "^10.9.1",
    "vite-plugin-terminal": "^1.2.0"
  }
}
